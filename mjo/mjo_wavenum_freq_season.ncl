;******************************************************
; Example script for working with "mjo_cross_segment"
; ncl -n mjo_wavenum_freq_season.ncl >> mjo_output/mjo_wavenum_freq_season_output.txt
;******************************************************
; These files are loaded by default in NCL V6.2.0 and newer
; load "$NCARG_ROOT/lib/ncarg/nclscripts/csm/gsn_code.ncl"   
; load "$NCARG_ROOT/lib/ncarg/nclscripts/csm/gsn_csm.ncl"    
; load "$NCARG_ROOT/lib/ncarg/nclscripts/csm/contributed.ncl"

; File with mjo_function loaded manually
load "$NCARG_ROOT/lib/ncarg/nclscripts/csm/diagnostics_cam.ncl"

; ------------- Read in data -----------------------

WORKDIR = systemfunc("pwd")
diri = "/data/anomaly/"
fili = "QBOi.EXP1.AMIP.001.u850.day.anom.nc" ; generated by MJO workflow 2_MJO_daily_anom
vName = "U850" ; name fo variable in the file

f = addfile(WORKDIR + diri + fili, "r")

; ------------- Specify a time/lat/lon range -----------------------

latS = -10. ; lat/lon range
latN = 10.  ; lat/lon rnage

twStrt = 19790101 ; time window start
twLast = 19811231 ; time window end

date  = cd_calendar(f->time, -2) ; convert date format of input file
iStrt = ind(date.eq.twStrt) ; index of start date range
iLast = ind(date.eq.twLast) ; index of end date range
delete(date) ; clean up

X = f->$vName$(iStrt:iLast,{latS:latN},:) 

;printVarSummary(X)

time = X&time ; time values
date = cd_calendar(time, -2) ; convert time values to YYYYMMDD

; ------------- MJO Clivar dim_avg_n_Wrap -----------------------
; Average data over latitude and use the averaged to compute spectra: https://www.ncl.ucar.edu/Applications/Scripts/mjoclivar_10.ncl

x = dim_avg_n_Wrap(X, 1)

; ------------- wavenumber -----------------------

nameSeason = "winter" ; "winter" or "summer" or "annual"
wf = mjo_wavenum_freq_season(x, date, nameSeason, False)

; printVarSummary(wf)
; Variable: wf
; Type: float
; Total Size: 209236 bytes
;            52309 values
; Number of Dimensions: 2
; Dimensions and sizes:	[wave | 289] x [freq | 181]
; Coordinates: 
;             wave: [-144..144]
;             freq: [-0.5..0.5]
; Number Of Attributes: 1
;   _FillValue :	1e+20

print(wf)

; ------------- plotting -----------------------
; https://www.ncl.ucar.edu/Applications/Scripts/mjoclivar_10.ncl

; pltDir = "mjo_output/"
; pltType = "png"
; pltName = "mjo_wavenum_freq_season_plot"
; mjo_wavenum_freq_season_plot(wf, nameSeason, pltDir, pltType, pltName, True)
; print("plot saved: " + pltName)
