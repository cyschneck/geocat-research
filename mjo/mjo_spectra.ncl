;******************************************************
; Example script for working with "mjo_spectra"
; ncl mjo_spectra.ncl
;******************************************************
; These files are loaded by default in NCL V6.2.0 and newer
; load "$NCARG_ROOT/lib/ncarg/nclscripts/csm/gsn_code.ncl"   
; load "$NCARG_ROOT/lib/ncarg/nclscripts/csm/gsn_csm.ncl"    
; load "$NCARG_ROOT/lib/ncarg/nclscripts/csm/contributed.ncl"

; File with mjo_function loaded manually
load "$NCARG_ROOT/lib/ncarg/nclscripts/csm/diagnostics_cam.ncl"

; ------------- Read in data -----------------------

WORKDIR = systemfunc("pwd")
diri = "/data/anomaly/"

filename = "QBOi.EXP1.AMIP.001.flut.day.anom.nc" ; generated by MJO workflow 2_MJO_daily_anom
vName = "FLUT" ; name fo variable in the file

f = addfile(WORKDIR + diri + filename, "r")

; ------------- Slice Input -----------------------

latS = (/ -10., -20. /)
latN = (/ 5., -5 /)
lonL = (/ 75. , 160. /)
lonR = (/ 100., 185. /)

twStrt = 19790101 ; time window start
twLast = 19811231 ; time window end

date = cd_calendar(f->time, -2) ; YYYYMMDD
iStrt = ind(date.eq.twStrt)
iLast = ind(date.eq.twLast)
delete(date)

X = f->$vName$(iStrt:iLast,:,:)

time = X&time
date = cd_calendar(time, -2) ; YYYYMMDD

; ------------- Input with MJO Cross Parameters -----------------------

nameRegion = (/ "IO", "WP" /)
lat = f->lat
wgty = cos(0.01745329*lat) ; MJO Clivar specify cos(pi/180 * lat)
copy_VarCoords(lat, wgty)

; ------------- Calculate and Plot MJO Spectra Parameters -----------------------

; ignore error: "sh: 1: convert: not found"
mjo_spectra(X, date, wgty, latS, latN, lonL, lonR, nameRegion, "mjo_output/", "png", "mjo_spectra", False)
