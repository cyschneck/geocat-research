;******************************************************
; Example script for working with "specx_anal" needed for mjo_spectra/mjo_spectra_season
; ncl specx_anal.ncl
;******************************************************
; These files are loaded by default in NCL V6.2.0 and newer
; load "$NCARG_ROOT/lib/ncarg/nclscripts/csm/gsn_code.ncl"   
; load "$NCARG_ROOT/lib/ncarg/nclscripts/csm/gsn_csm.ncl"    
; load "$NCARG_ROOT/lib/ncarg/nclscripts/csm/contributed.ncl"

; ------------- Read in data -----------------------

WORKDIR = systemfunc("pwd")
diri = "/data/anomaly/"

diri = "/data/anomaly/"

filename = "QBOi.EXP1.AMIP.001.flut.day.anom.nc" ; generated by MJO workflow 2_MJO_daily_anom
vName = "FLUT" ; name of variable in the file

f = addfile(WORKDIR + diri + filename, "r")

; ------------- Slice Input -----------------------

twStrt = 19790101 ; time window start
twLast = 19811231 ; time window end

latS = -15. ; lat/lon range
latN = 15.  ; lat/lon rnage

date = cd_calendar(f->time, -2) ; YYYYMMDD
iStrt = ind(date.eq.twStrt)
iLast = ind(date.eq.twLast)
delete(date)

X = f->$vName$(iStrt:iLast,{latS:latN},:)
;printVarSummary(X)

; ------------ Convert Data to 1D Array --------------

lat = X&lat
wgty = cos(0.01745329*lat) ; MJO Clivar specify cos(pi/180 * lat)
xts  = wgt_areaave_Wrap(X, wgty, 1., 0)

; ------------- Spectral Analysis --------------------

d = 0      ; detrending (remove series mean)
sm = 0     ; smooth periodogram (no smoothing, 0 = pure periodogram)
pct = 0.1  ; percent tapered, 10% (common)

spectra_degrees_of_freedom = specx_anal(xts, d, sm, pct)
print(spectra_degrees_of_freedom)

